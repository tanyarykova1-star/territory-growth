  }

  .faq-title {
    padding: 20px 24px;
    font-size: 17px;
    font-weight: 700;
    color: #0f172a;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }
  .faq-title::-webkit-details-marker {
    display: none;
  }

  /* Стрелочка плюсик/минусик */
  .icon {
    width: 20px;
    height: 20px;
    position: relative;
    flex-shrink: 0;
  }
  .icon::before, .icon::after {
    content: '';
